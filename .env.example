# ============================================================
# EDNC LMS 통합 환경설정 (이 파일 하나로 backend / frontend / PM2 모두 설정)
# 복사 후 사용: cp .env.example .env
# backend/.env, frontend/.env 는 더 이상 사용하지 않습니다.
# ============================================================

# 서버 네트워크 설정
# SERVER_IP: 서버 접속 주소 (IP 또는 DDNS 호스트명, 예: ednc-dj2.iptime.org)
#            production 모드에서 백엔드 CORS 허용 출처로 사용됨
# 프론트엔드의 API 주소는 브라우저 접속 주소 + BACKEND_PORT 로 자동 결정되므로 별도 설정 불필요
SERVER_IP=192.168.1.100
FRONTEND_PORT=3600
BACKEND_PORT=3601

# 보안 설정 - 반드시 변경하세요
JWT_SECRET=your-super-secret-jwt-key-here-please-change-this
ADMIN_PASSWORD=change-me

# 실행 환경 (development: CORS 전체 허용)
NODE_ENV=development

# 시스템 설정
TZ=Asia/Seoul
LANG=ko_KR.UTF-8
